{
  "name": "dsh-computer-use",
  "version": "1.6.0",
  "private": false,
  "type": "module",
  "description": "Desktop screenshots and real mouse/keyboard input for agents. Windows native (PowerShell + SendInput) and Linux/X11 (xdotool/scrot); selected at runtime by backends/index.mjs.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.web.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.web.js",
    "scripts/build-client.mjs",
    "backends",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README-DEV.md",
    "tests",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "prepack": "node scripts/build-client.mjs",
    "test": "node tests/adapter-selftest.mjs && node backends/selftest.mjs",
    "test:e2e": "node tests/linux-integration.mjs",
    "test:smoke": "node backends/smoke-linux.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "author": "linzhicong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicken/dsh-computer-use.git"
  },
  "homepage": "https://github.com/nicken/dsh-computer-use#readme",
  "bugs": {
    "url": "https://github.com/nicken/dsh-computer-use/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "computer-use",
    "desktop-automation",
    "x11",
    "xdotool",
    "windows",
    "agent"
  ],
  "engines": {
    "node": ">=22"
  }
}
